# Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=momu
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/momu

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Telegram order polling (заявки от сайта создают договоры)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Интервал опроса Telegram по расписанию (celery beat), в секундах
TELEGRAM_POLL_INTERVAL_SECONDS=300

# JWT Configuration
# ВАЖНО: Измените эти секреты в production!
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Email Configuration
# Режим: 'file' для разработки (сохраняет письма в logs/emails/), 'smtp' для продакшна
EMAIL_MODE=file

# Frontend URL (для ссылок в письмах)
FRONTEND_URL=http://localhost:5173

# SMTP Configuration (используется только если EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM="MOMU Project" <noreply@momu.kz>

# Document storage configuration
# Relative paths are resolved against the docs/ folder (mounted as /docs in Docker),
# not against the process working directory. Set an absolute path in CONTRACTS_DIR
# to move contract storage anywhere else - that alone is enough.
CONTRACTS_DIR=contract
CONTRACT_TEMPLATE_PATH=templates/contract_template_phys.docx
